local function myChar()
	local char = lp.Character
	if not char then return nil, nil, nil end
	return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end

local function focused()
	if not api.isrbxactive then return true end
	local ok, active = pcall(api.isrbxactive)
	if ok then return active == true end
	return true
end

local function releaseAll()
	if api.mouse1release then pcall(api.mouse1release) end
	if api.keyrelease then
		pcall(api.keyrelease, 0x52) -- R
		pcall(api.keyrelease, 0x20) -- Space
		pcall(api.keyrelease, 0x57) -- W
	end
end

local function click()
	if api.mouse1click then
		pcall(api.mouse1click)
		return true
	elseif api.mouse1press and api.mouse1release then
		pcall(api.mouse1press)
		task.delay(0.04, function()
			pcall(api.mouse1release)
		end)
		return true
	end
	return false
end

-- the refill tank, cached; re-checked by Parent on every use
local refillObject = nil

local function refillPart()
	if refillObject and refillObject.Parent then return refillObject end
	refillObject = nil
	local unclimbable = workspace:FindFirstChild("Unclimbable")
	if not unclimbable then return nil end
	local camps = unclimbable:FindFirstChild("Camps")
	local camp = camps and camps:FindFirstChild("Camp")
	local tanks = camp and camp:FindFirstChild("GasTanks")
	local part = tanks and tanks:FindFirstChild("Refill")
	if part and part:IsA("BasePart") then
		refillObject = part
		return part
	end
	-- other maps name the camp differently: scan once, then cache the part
	for _, descendant in ipairs(unclimbable:GetDescendants()) do
		if descendant.Name == "Refill" and descendant:IsA("BasePart") then
			refillObject = descendant
			return descendant
		end
	end
	return nil
end

local function safeSpot()
	local part = refillPart()
	if part then return part.Position + Vector3.new(0, 3, 0) end
	local spawn = workspace:FindFirstChild("SpawnLocation")
	if spawn and spawn:IsA("BasePart") then return spawn.Position + Vector3.new(0, 6, 0) end
	return nil
end

--============================================================================
--  TITAN DATA
--============================================================================
local function napeOf(model)
	local hitboxes = model:FindFirstChild("Hitboxes")
	local hit = hitboxes and hitboxes:FindFirstChild("Hit")
	return hit and hit:FindFirstChild("Nape") or nil
end

local function hpOf(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.Health or -1
end

local function dead(model)
	if model == nil or model.Parent == nil then return true end
	local ok, flag = pcall(function() return model:GetAttribute("Dead") end)
	if ok and flag == true then return true end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then return true end
	return humanoid.Health <= 0
end

local function attackTitan()
	local folder = workspace:FindFirstChild("Titans")
	local titan = folder and folder:FindFirstChild("Attack_Titan")
	if titan and titan.Parent and not dead(titan) then return titan end
	return nil
end

local function roaring(titan)
	if not titan then return false end
	local ok, value = pcall(function() return titan:GetAttribute("Attack") end)
	return ok and value == "Roar"
end

-- How many living titans have a nape inside cfg.multiRadius of this one. The
-- group-hit farm aims at the middle of a crowd instead of the closest titan:
-- one swing then lands on several napes at once.
local function clusterCentre(model)
	local probe = napeOf(model)
	if not probe then return nil end
	local okPos, centre = pcall(function() return probe.Position end)
	if not okPos or not centre then return nil end
	local folder = workspace:FindFirstChild("Titans")
	if not folder then return nil end
	local sum, count = Vector3.new(0, 0, 0), 0
	for _, other in ipairs(folder:GetChildren()) do
		if other:IsA("Model") and other ~= model and not dead(other) then
			local nape = napeOf(other)
			if nape then
				local ok, pos = pcall(function() return nape.Position end)
				if ok and pos and (pos - centre).Magnitude <= cfg.multiRadius then
					sum = sum + pos
					count = count + 1
				end
			end
		end
	end
	if count == 0 then return centre end
	return Vector3.new(sum.X / (count + 1), sum.Y / (count + 1), sum.Z / (count + 1))
end

local function clusterAt(model, origin)
	local probe = napeOf(model)
	if not probe then return 0 end
	local okPos, centre = pcall(function() return probe.Position end)
	if not okPos or not centre then return 0 end
	local folder = workspace:FindFirstChild("Titans")
	if not folder then return 0 end
	local count = 0
	for _, other in ipairs(folder:GetChildren()) do
		if other:IsA("Model") and other ~= model and not dead(other) then
			local nape = napeOf(other)
			if nape then
				local ok, pos = pcall(function() return nape.Position end)
				if ok and pos and (pos - centre).Magnitude <= cfg.multiRadius then
					count = count + 1
				end
			end
		end
	end
	return count
end

-- nearest | attack (Attack Titan first) | hp (lowest health first)
local function chooseTarget()
	local folder = workspace:FindFirstChild("Titans")
	local _, root = myChar()
	if not folder or not root then return nil end
	local origin = root.Position
	local boss = attackTitan()

	if boss and not roaring(boss) and cfg.priority ~= "hp" and cfg.masteryTitan == "" then
		local nape = napeOf(boss)
		local hrp = boss:FindFirstChild("HumanoidRootPart")
		if nape and hrp then
			return { model = boss, nape = nape, name = boss.Name, dist = (hrp.Position - origin).Magnitude }
		end
	end

	local best, bestScore = nil, nil
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") and not dead(model) and not (model == boss and roaring(model)) then
			local nape = napeOf(model)
			local hrp = model:FindFirstChild("HumanoidRootPart")
			if nape and hrp then
				local distance = (hrp.Position - origin).Magnitude
				local score = distance
				if cfg.priority == "hp" then score = hpOf(model) * 10000 + distance end
				-- mastery farm: everything that is not the wanted titan sinks
				if cfg.masteryTitan ~= "" then
					if not string.find(string.lower(tostring(model.Name)), string.lower(cfg.masteryTitan), 1, true) then
						score = score + 1000000
					end
				end
				-- group mode: only a crowd at least multiMin deep is worth a detour
				if cfg.multiHit then
					local crowd = clusterAt(model, origin)
					if crowd >= cfg.multiMin then score = score - crowd * 1000 end
				end
				if bestScore == nil or score < bestScore then
					bestScore = score
					best = { model = model, nape = nape, name = model.Name, dist = distance }
				end
			end
		end
	end
	return best
end

--============================================================================
--  NAPE EXTENDER + MAGNET
--============================================================================
local napeStock = {}   -- [Part] = { size = Vector3 }

local function applyNapes()
	if not cfg.napeEnabled then
		S.napeParts = 0
		return 0
	end
	local folder = workspace:FindFirstChild("Titans")
	local _, root = myChar()
	if not folder or not root then return 0 end
	local origin = root.Position
	local grown = 0

	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local hrp = model:FindFirstChild("HumanoidRootPart")
			-- the magnet owns the target's nape while it is on, size included
			local isTarget = cfg.magnet and S.target ~= nil and S.target.model == model
			if hrp and isTarget then
				-- the magnet owns this nape, size included, but it is still grown:
				-- count it so the status line matches what is on screen
				grown = grown + 1
			elseif hrp then
				local ok, near = pcall(function()
					return (hrp.Position - origin).Magnitude <= cfg.napeRange
				end)
				if ok and near then
					local nape = napeOf(model)
					if nape then
						local entry = napeStock[nape]
						if not entry then
							entry = { size = nape.Size }
							napeStock[nape] = entry
						end
						local want = entry.size * cfg.napeMult
						if (nape.Size - want).Magnitude > 0.05 then
							pcall(function() nape.Size = want end)
						end
						grown = grown + 1
					end
				end
			end
		end
	end
	S.napeParts = grown
	return grown
end

local function restoreNapes()
	local restored = 0
	for part, entry in pairs(napeStock) do
		if part and part.Parent then
			if pcall(function() part.Size = entry.size end) then restored = restored + 1 end
		end
		napeStock[part] = nil
	end
	S.napeParts = 0
	return restored
end

local function pruneNapes()
	for part in pairs(napeStock) do
		if part == nil or part.Parent == nil then napeStock[part] = nil end
	end
end

local function magnetTick(target, root)
	if not cfg.magnet then return end
	local nape = target.nape
	if not nape or not nape.Parent then
		target.nape = napeOf(target.model)
		nape = target.nape
	end
	if not nape then return end
	-- Remember the stock size before the magnet changes it, so Restore napes
	-- also resets the titan that happened to be the current target.
	if not napeStock[nape] then napeStock[nape] = { size = nape.Size } end
	local position = root.Position
	local want = cfg.magnetSize
	pcall(function()
		if math.abs(nape.Size.X - want) > 0.1 then
			nape.Size = Vector3.new(want, want, want)
		end
		-- the weld reverts a single write; re-asserting every frame is the trick
		nape.Position = Vector3.new(position.X, position.Y + cfg.magnetY, position.Z)
	end)
end

