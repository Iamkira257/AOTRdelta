local Stats = {
	data = {
		missions = 0, raids = 0, waves = 0, rounds = 0, kills = 0,
		boss = 0, mythical = 0, seconds = 0, byType = {}, started = os.time(),
	},
}
local STATS_PATH = "Vega/aotr_stats.json"

local function loadStats()
	if not api.readfile then return end
	local ok, source = pcall(api.readfile, STATS_PATH)
	if not ok or type(source) ~= "string" or #source < 2 then return end
	local okDecode, data = pcall(function() return HttpService:JSONDecode(source) end)
	if not okDecode or type(data) ~= "table" then return end
	for key, value in pairs(data) do
		if type(Stats.data[key]) == type(value) then Stats.data[key] = value end
	end
end

local function saveStats()
	if not api.writefile then return end
	if api.makefolder then pcall(api.makefolder, "Vega") end
	local ok, encoded = pcall(function() return HttpService:JSONEncode(Stats.data) end)
	if ok then pcall(api.writefile, STATS_PATH, encoded) end
end

local Webhook = { queue = {}, busy = false, last = 0 }

local function httpPost(url, payload)
	local requestFn = (type(request) == "function" and request)
		or (type(http_request) == "function" and http_request)
		or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
		or (type(fluxus) == "table" and type(fluxus.request) == "function" and fluxus.request)
		or (type(http) == "table" and type(http.request) == "function" and http.request)
	if not requestFn then return false, "no http API" end
	local okBody, body = pcall(function() return HttpService:JSONEncode(payload) end)
	if not okBody then return false, body end
	local okCall, response = pcall(requestFn, {
		Url = url,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = body,
	})
	if not okCall then return false, tostring(response) end
	local code = 0
	if type(response) == "table" then code = tonumber(response.StatusCode or response.Status or 0) or 0 end
	return code >= 200 and code < 300, code
end

local function embed(title, description, color, fields)
	return {
		title = title,
		description = description,
		color = color or 0x5BC0EB,
		fields = fields or {},
		footer = { text = "AOTR Delta v" .. VERSION },
		timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
	}
end

local function webhookPush(url, payload)
	if type(url) ~= "string" or url == "" then return false end
	if not string.find(url, "https://discord", 1, true) and not string.find(url, "https://canary.discord", 1, true) then
		return false, "not a Discord webhook URL"
	end
	Webhook.queue[#Webhook.queue + 1] = { url = url, payload = payload }
	if not Webhook.busy then
		Webhook.busy = true
		task.spawn(function()
			while #Webhook.queue > 0 do
				local item = table.remove(Webhook.queue, 1)
				local wait = math.max(0, 2 - (clock() - Webhook.last))
				if wait > 0 then task.wait(wait) end
				Webhook.last = clock()
				local ok, detail = httpPost(item.url, item.payload)
				if not ok then say("webhook: " .. tostring(detail)) end
			end
			Webhook.busy = false
		end)
	end
	return true
end

local function statsFields()
	local data = Stats.data
	return {
		{ name = "Missions", value = tostring(data.missions or 0), inline = true },
		{ name = "Raids", value = tostring(data.raids or 0), inline = true },
		{ name = "Waves", value = tostring(data.waves or 0), inline = true },
		{ name = "Kills", value = tostring(data.kills or 0), inline = true },
		{ name = "Rounds", value = tostring(data.rounds or 0), inline = true },
		{ name = "Boss skins", value = tostring(data.boss or 0), inline = true },
		{ name = "Mythical families", value = tostring(data.mythical or 0), inline = true },
		{ name = "Playtime", value = string.format("%d min", math.floor((data.seconds or 0) / 60)), inline = true },
	}
end

