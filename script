local function resultsInfo()
	local playerGui = lp:FindFirstChild("PlayerGui")
	local interface = playerGui and playerGui:FindFirstChild("Interface")
	local rewards = interface and interface:FindFirstChild("Rewards")
	local main = rewards and rewards:FindFirstChild("Main")
	return main and main:FindFirstChild("Info")
end

local function resultsSignature()
	-- in the lobby the same labels keep the last round's values; workspace.Type
	-- is nil there, so nothing is retried before a mission exists
	local okType, missionType = pcall(function() return workspace:GetAttribute("Type") end)
	if not okType or missionType == nil then return nil end
	local info = resultsInfo()
	if not info then return nil end
	local stateLabel = info:FindFirstChild("State")
	if not stateLabel then return nil end
	local ok, text = pcall(function() return stateLabel.Text end)
	if not ok or type(text) ~= "string" then return nil end
	local upper = string.upper(text)
	local completed = string.find(upper, "COMPLETED", 1, true) ~= nil
	local failed = string.find(upper, "FAILED", 1, true) ~= nil
	if not completed and not failed then return nil end

	local parts = { upper }
	local main = info:FindFirstChild("Main")
	local stats = main and main:FindFirstChild("Stats")
	for _, name in ipairs({ "Time_Taken", "Damage", "Kills", "Crits" }) do
		local row = stats and stats:FindFirstChild(name)
		local amount = row and row:FindFirstChild("Amount")
		local okAmount, value = pcall(function() return amount.Text end)
		parts[#parts + 1] = tostring(okAmount and value or "?")
	end
	local okSeconds, seconds = pcall(function() return workspace:GetAttribute("Seconds") end)
	parts[#parts + 1] = tostring(okSeconds and seconds or "?")
	return table.concat(parts, "|")
end

local function findResultsButton()
	local playerGui = lp:FindFirstChild("PlayerGui")
	local interface = playerGui and playerGui:FindFirstChild("Interface")
	local rewards = interface and interface:FindFirstChild("Rewards")
	if not rewards then return nil end
	for _, descendant in ipairs(rewards:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			local name = string.lower(descendant.Name)
			local text = ""
			pcall(function() text = string.lower(descendant.Text) end)
			if string.find(name, "retry", 1, true)
				or string.find(text, "retry", 1, true)
				or string.find(text, "play again", 1, true) then
				return descendant
			end
		end
	end
	return nil
end

-- Fire every non-executor connection of a GUI signal: that is one real click's
-- worth of handlers. isexecutorclosure keeps our own listeners out of it.
local function fireSignal(signal)
	if signal == nil then return false end
	local fired = 0
	local scanned = false
	if api.getconnections then
		scanned = true
		local ok, connections = pcall(api.getconnections, signal)
		if ok and type(connections) == "table" then
			for _, connection in ipairs(connections) do
				local ours = false
				if api.isexecutorclosure then
					local okFn, fn = pcall(function() return connection.Function end)
					if okFn and type(fn) == "function" then
						local okCheck, executorOwned = pcall(api.isexecutorclosure, fn)
						ours = okCheck and executorOwned == true
					end
				end
				if not ours then
					local okFire = pcall(function()
						if type(connection.Fire) == "function" then
							return connection.Fire(connection)
						end
						return connection:Fire()
					end)
					if okFire then fired = fired + 1 end
				end
			end
		end
	end
	-- firesignal is only a fallback when the executor cannot enumerate
	-- connections: calling it on an empty signal would look like success while
	-- nothing happened, and the retry would then be latched for that result
	if fired == 0 and not scanned and api.firesignal then
		if pcall(api.firesignal, signal) then fired = 1 end
	end
	return fired > 0
end

local function pressRetry(force)
	-- never send the backslash / D / D / Enter sequence into a live mission:
	-- outside the results screen those keys open menus and move the character
	if not force and resultsSignature() == nil and findResultsButton() == nil then
		return false, "no results screen"
	end
	local button = findResultsButton()
	if button then
		if fireSignal(button.Activated) then return true, "button" end
		local okClick = pcall(function() return button.MouseButton1Click end)
		if okClick and fireSignal(button.MouseButton1Click) then return true, "click" end
	end

	if not api.keypress or not api.keyrelease then
		return false, "no keyboard API and no Retry button"
	end

	local function tap(vk, hold, gap)
		pcall(api.keypress, vk)
		task.wait(hold or 0.1)
		pcall(api.keyrelease, vk)
		task.wait(gap or 0.15)
	end

	-- the game's own results-screen navigation: Leave_2 -> Modify -> Retry
	tap(0xDC, 0.15, 0.55)          -- backslash enters key navigation
	tap(cfg.retryRight, 0.10, 0.25)
	tap(cfg.retryRight, 0.10, 0.25)
	tap(0x0D, 0.15, 0.45)          -- Enter
	tap(0xDC, 0.15, 0.30)
	return true, "keys"
end

local function retryTick(now)
	-- detect the results screen even with auto retry off, so the farm stops
	-- attacking a round that has already ended
	local signature = resultsSignature()
	if signature == nil then
		S.results = false
		return
	end
	S.results = true
	S.target = nil
	S.refilling = false
	-- one hook per unique result: lifetime stats, rewards webhook, boss-skin
	-- check and rejoin. It runs even with auto retry off, so the stats are
	-- recorded for manual play too.
	if S.resultSeenSig ~= signature then
		S.resultSeenSig = signature
		if resultHook then
			local okHook, handled = pcall(resultHook, signature)
			if not okHook then S.err = tostring(handled) end
			if okHook and handled then return end
		end
	end
	if not cfg.autoRetry then return end

	if S.retrySig == signature then return end
	if S.lastRetry and (now - S.lastRetry) < cfg.retryCooldown then return end
	if cfg.retryMax > 0 and (S.retryTries or 0) >= cfg.retryMax then
		S.state = "retry cap reached"
		return
	end
	if not focused() then
		S.state = "results screen - window unfocused"
		return
	end

	S.retrySig = signature
	S.lastRetry = now
	S.retryTries = (S.retryTries or 0) + 1
	S.state = "retry " .. tostring(S.retryTries)
	task.spawn(function()
			local ok, sent, how = pcall(pressRetry, true)
			if ok and sent then
				S.state = "retry sent (" .. tostring(how) .. ")"
			else
				S.state = "retry failed"
				S.err = ok and tostring(how) or tostring(sent)
				-- do not latch a failed attempt: the cooldown may try again
				S.retrySig = nil
			end
		end)
end

--============================================================================
--  UI-AWARE PAUSE
--============================================================================
-- Clicking the menu must not also swing a blade. The farm pauses while a
-- textbox has focus, while the pointer is over the open window, and briefly
-- after it leaves.
local function uiBusy()
	if not cfg.uiGuard then return false end
	local now = clock()
	local okFocus, textBox = pcall(function() return UserInputService:GetFocusedTextBox() end)
	if okFocus and textBox then
		S.uiHold = now
		return true
	end
	-- The menu collapses to its title bar in the top-left while farming, so a
	-- synthetic click at the aim point cannot press it. While it is collapsed
	-- it does not block the farm; the user can reopen it (and press Stop) at
	-- any time, which is the only stop path a touch-only device has.
	local win = UI.win
	if win and win:IsOpen() then
		local collapsed = type(win.IsCollapsed) == "function" and win:IsCollapsed()
		if not collapsed then
			S.uiHold = now
			return true
		end
	end
	-- The floating UI button stays on screen while farming. If the synthetic
	-- click follows the last touch, parking the cursor on that button would
	-- reopen the menu forever, so pause while the pointer is over it.
	if win and type(win.GetFabBounds) == "function" then
		local fabX, fabY, fabW, fabH = win:GetFabBounds()
		if fabX then
			local mouse = UserInputService:GetMouseLocation()
			local inset = 0
			pcall(function() inset = GuiService:GetGuiInset().Y end)
			local mouseY = mouse.Y - inset
			if mouse.X >= fabX and mouse.X <= fabX + fabW and mouseY >= fabY and mouseY <= fabY + fabH then
				S.uiHold = now
				return true
			end
		end
	end
	if S.uiHold > 0 and (now - S.uiHold) < 0.35 then return true end
	return false
end

