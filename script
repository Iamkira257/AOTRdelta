--  MOVEMENT / AIM
--============================================================================
local function hoverAt(root, point, height)
	local bob = math.sin(clock() * cfg.bobHz * 6.28318) * cfg.bobAmp
	pcall(function()
		root.Position = Vector3.new(point.X, point.Y + height + bob, point.Z)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end)
end

local function aimAt(root, camera, point)
	pcall(function()
		local from = root.Position
		if (point - from).Magnitude > 0.05 then
			root.CFrame = CFrame.lookAt(from, point)
		end
	end)
	if camera then
		pcall(function()
			local from = camera.CFrame.Position
			if (point - from).Magnitude > 0.05 then
				camera.CFrame = CFrame.lookAt(from, point)
			end
		end)
	end
end

