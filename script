end

local function shadowStep(now)
	if not cfg.shadowCheck then return end
	if now - (S.shadowAt or 0) < 60 then return end
	S.shadowAt = now
	local findings = {}
	local function scanAttributes(instance, label)
		local ok, attributes = pcall(function() return instance:GetAttributes() end)
		if not ok or type(attributes) ~= "table" then return end
		for key, value in pairs(attributes) do
			local flat = normText(key)
			if string.find(flat, "ban", 1, true) or string.find(flat, "restrict", 1, true)
				or string.find(flat, "suspend", 1, true) then
				if value ~= nil and value ~= false then
					findings[#findings + 1] = label .. "." .. key .. "=" .. tostring(value)
				end
			end
		end
	end
	scanAttributes(lp, "player")
	scanAttributes(workspace, "workspace")
	scanAttributes(game, "game")
	local playerGui = lp:FindFirstChild("PlayerGui")
	if playerGui then
		for _, instance in ipairs(playerGui:GetDescendants()) do
			if instance:IsA("TextLabel") and guiVisible(instance) then
				local ok, text = pcall(function() return instance.Text end)
				if ok and type(text) == "string" then
					local flat = normText(text)
					if string.find(flat, "shadowban", 1, true) or string.find(flat, "banned", 1, true)
						or string.find(flat, "suspended", 1, true) then
						findings[#findings + 1] = "ui: " .. text:sub(1, 70)
					end
				end
			end
		end
	end
	if #Players:GetPlayers() <= 1 then
		S.aloneSince = S.aloneSince or now
		if now - S.aloneSince >= 180 then
			findings[#findings + 1] = "no other players for 3+ minutes (possible shadow pool)"
		end
	else
		S.aloneSince = nil
	end
	S.shadow = #findings == 0 and "clear" or table.concat(findings, " | ")
	if #findings > 0 then
		say("shadow check: " .. S.shadow)
		if cfg.webhookStats ~= "" then
			webhookPush(cfg.webhookStats, {
				username = "AOTR Delta",
				embeds = { embed("Shadow-ban check", S.shadow:sub(1, 900), 0xF87171,
					{ { name = "Player", value = lp.Name, inline = true } }) },
			})
		end
	end
end

--============================================================================
--  LOOPS
--============================================================================
local startFarm, stopFarm, setFarm

local function attackReady()
	if not S.running or S.refilling or S.results then return false end
	if cfg.focusGuard and not focused() then return false end
	if uiBusy() then return false end
	local target = S.target
	if not target or dead(target.model) then return false end
	if not S.dist then return false end
	local reach = math.max(22, cfg.hoverClose + 12)
	if S.dist > reach then return false end
	return true
end

local function attackTick()
	if not attackReady() then return end
	if click() then
		S.swings = S.swings + 1
		-- the loop that measured 4 kills in 6 s tapped Space with every M1;
		-- it is a tap, never a hold, so movement is unaffected
		if cfg.pressSpace and api.keypress then
			pcall(api.keypress, 0x20)
			pcall(api.keyrelease, 0x20)
		end
	end
end

local function fastTick()
	if not S.running then return end
	local now = clock()

	if cfg.focusGuard and not focused() then
		local _, root = myChar()
		local spot = safeSpot()
		if root and spot then
			pcall(function()
				root.Position = spot
				root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end)
		end
		releaseAll()
		S.state = "window not focused - parked"
		return
	end

	local char, root, humanoid = myChar()
	if not root then
		S.state = "no character"
		S.target = nil
		return
	end
	if humanoid and humanoid.Health <= 0 then
		releaseAll()
		S.state = "dead - waiting for respawn"
		S.target = nil
		return
	end
	if S.soloBlocked then
		releaseAll()
		S.state = "solo only - " .. tostring(#Players:GetPlayers()) .. " players in server"
		return
	end
	if uiBusy() then
		-- no synthetic mouse input here: the user may be dragging a slider with a
		-- real finger, and a release would cancel that drag
		S.state = "menu - farm paused"
		return
	end
	if S.results then
		S.state = "results screen - waiting for retry"
		return
	end
	if S.refilling or now >= (S.nextRefillCheck or 0) then
		S.nextRefillCheck = now + (S.refilling and 0.1 or 0.25)
		if refillTick(now, root) then return end
	end

	spearsStep(now)
	if cfg.autoEscape and isGrabbed() then
		escapeStep(now)
		S.state = "escaping a grab"
		return
	end
	skillsStep(now)

	local target = S.target
	if target and dead(target.model) then
		S.target = nil
		target = nil
	end
	if not target then
		S.target = chooseTarget()
		target = S.target
	end
	if not target then
		releaseAll()
		S.state = "no titans in range"
		return
	end

	local hrp = target.model:FindFirstChild("HumanoidRootPart")
	if not hrp then
		S.target = nil
		return
	end
	local nape = target.nape
	if not nape or not nape.Parent then
		target.nape = napeOf(target.model)
		nape = target.nape
	end
	if not nape then
		S.state = "target has no nape"
		return
	end

	local height = cfg.hover
	local name = target.name
	if name == "Attack_Titan" then
		height = cfg.hoverAttack
	else
		local okType, titanType = pcall(function() return target.model:GetAttribute("Type") end)
		if okType and (titanType == "Colossal" or titanType == "Stall") then
			height = cfg.hoverBig
		end
	end

	-- Tween travel: anything further than travelNear is flown to at a capped
	-- speed instead of being snapped to. The last stretch is the existing
	-- hover + magnet, so the attack still starts from the measured position.
	if cfg.moveMode == "tween" then
		if S.travelling then
			S.state = "tweening to " .. tostring(name)
			return
		end
		local flat = Vector3.new(root.Position.X - hrp.Position.X, 0, root.Position.Z - hrp.Position.Z).Magnitude
		if flat > cfg.travelNear then
			Move.travel(hrp.Position + Vector3.new(0, height, 0), cfg.travelSpeed)
			S.state = "tweening to " .. tostring(name)
			return
		end
	end

	S.cluster = cfg.multiHit and clusterAt(target.model, root.Position) or 0

	if cfg.magnet then
		hoverAt(root, hrp.Position, height)
		magnetTick(target, root)
	else
		-- no magnet: get close to the nape itself, or the blade cannot reach it
		local okPos, napePos = pcall(function() return nape.Position end)
		if okPos and napePos then hoverAt(root, napePos, cfg.hoverClose) end
	end

	-- group mode aims at the middle of the crowd, not at the target's own nape:
	-- one spear explosion then covers every nape inside multiRadius
	local aimPoint = nape.Position
	if cfg.multiHit and (S.cluster or 0) >= cfg.multiMin then
		local centre = clusterCentre(target.model)
		if centre then aimPoint = centre end
	end

	local okDist, distance = pcall(function() return (aimPoint - root.Position).Magnitude end)
	S.dist = okDist and distance or nil

	S.aimTick = (S.aimTick or 0) + 1
	if S.aimTick % 2 == 1 and okDist then
		local camera = workspace.CurrentCamera
		aimAt(root, camera, aimPoint)
	end

	S.state = "attacking " .. tostring(name)
end

local function slowTick()
	local now = clock()

	-- lifetime playtime, sampled from the slow loop so a background tab does
	-- not inflate it with a long single frame
	local delta = now - (S.lastSlow or now)
	S.lastSlow = now
	Stats.data.seconds = (Stats.data.seconds or 0) + math.max(0, delta)

	if cfg.napeEnabled then
		applyNapes()
	else
		S.napeParts = 0
	end
	pruneNapes()

	local stat = nil
	pcall(function() stat = tonumber(lp:GetAttribute("Stat")) end)
	if stat ~= nil and S.statSeen ~= nil and stat > S.statSeen then
		local gained = stat - S.statSeen
		S.kills = S.kills + gained
		Stats.data.kills = (Stats.data.kills or 0) + gained
		local key = S.target and S.target.name or "unknown"
		Stats.data.byType[key] = (Stats.data.byType[key] or 0) + gained
	end
	S.statSeen = stat

	S.gas = gasPercent()
	S.refills = refills()
	S.bladesBroken = bladesAllBroken(lp.Character)

	-- solo mode: pause (or hop) when somebody else is in the server
	if cfg.soloOnly then
		local count = #Players:GetPlayers()
		S.soloBlocked = count > 1
		if S.soloBlocked and cfg.soloAction == "hop" and now >= (S.soloHopAt or 0) then
			S.soloHopAt = now + 12
			rejoinNow("solo mode: " .. count .. " players")
		end
	else
		S.soloBlocked = false
	end

	-- stuck fail-safe: the target is not getting closer and we are not flying
	if cfg.stuckDetect and S.running and not S.results and S.target and not S.travelling
		and not S.refilling then
		local _, root = myChar()
		local okDist, distance = pcall(function()
			return (S.target.nape.Position - root.Position).Magnitude
		end)
		if okDist and distance and root then
			if S.lastDist and distance > (S.lastDist - 1) then
				S.stuckSince = S.stuckSince or now
			else
				S.stuckSince = now
			end
			S.lastDist = distance
			if now - (S.stuckSince or now) > cfg.stuckTime then
				S.stuckCount = (S.stuckCount or 0) + 1
				S.stuckSince = now
				S.lastDist = nil
				S.target = nil
				Move.cancel()
				S.autoMsg = "stuck - retargeting (" .. S.stuckCount .. ")"
				if cfg.autoRejoinStuck and S.stuckCount >= 3 then
					S.stuckCount = 0
					rejoinNow("stuck three times")
				end
			end
		end
	else
		S.stuckSince, S.lastDist = nil, nil
	end

	local folder = workspace:FindFirstChild("Titans")
	local alive = 0
	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") and not dead(model) then alive = alive + 1 end
		end
	end
	S.alive = alive

	if not S.rateAt then
		S.rateAt, S.rateSwings = now, S.swings
	end
	if now - S.rateAt >= 1 then
		S.rate = (S.swings - S.rateSwings) / (now - S.rateAt)
		S.rateAt, S.rateSwings = now, S.swings
	end

	retryTick(now)

	-- one modifier pass per lobby visit; a live round re-arms it for the next
	if roundActive() then ModifierGate.done = false end
	autoStartStep(now)
	autoModifiersStep(now)
	progressionStep(now)
	familyStep(now)
	shadowStep(now)

	if now - (S.statsSavedAt or 0) > 60 then
		S.statsSavedAt = now
		saveStats()
	end
	if cfg.webhookStats ~= "" and cfg.statsInterval > 0
		and now - (S.statsAt or now) >= cfg.statsInterval then
		S.statsAt = now
		webhookPush(cfg.webhookStats, {
			username = "AOTR Delta",
			embeds = { embed("Lifetime stats", "Running total for " .. lp.Name, 0x5BC0EB, statsFields()) },
		})
	end

	refreshStatus()
end

-- The menu collapses to a 46px title bar in the top-left corner while a run
-- is active: out of the way of the aim point, but still on screen so a touch
-- user can reopen it and press Stop. F5 does the same with a keyboard.
local uiPrev

local function compactUI()
	local win = UI.win
	if not win then return end
	local x, y = win:GetPosition()
	uiPrev = { x = x, y = y, collapsed = win:IsCollapsed() and true or false }
	if cfg.autoHideGui then
		-- fully hidden: the floating button reopens it, and F5 still stops
		win:SetFabVisible(true)
		win:Hide()
		return
	end
	win:SetFabVisible(false)
	win:SetPosition(8, 8)
	win:SetCollapsed(true)
end

local function restoreUI()
	local win = UI.win
	if not win then return end
	win:SetCollapsed(uiPrev and uiPrev.collapsed or false)
	if uiPrev then win:SetPosition(uiPrev.x, uiPrev.y) end
	win:SetFabVisible(true)
	win:Open()
	uiPrev = nil
end

startFarm = function()
	if S.running then return true end
	local char, root = myChar()
	if not root then
		S.state = "no character - wait for the spawn"
		syncFarmToggle()
		refreshStatus()
		return false, "no character"
	end
	if game.PlaceId ~= PLACE then
		say("warning: place is " .. tostring(game.PlaceId) .. ", expected " .. tostring(PLACE))
	end

	S.running = true
	S.runId = (S.runId or 0) + 1
	local runId = S.runId
	S.err = nil
	S.results = false
	S.refilling = false
	S.retryTries, S.lastRetry, S.retrySig = 0, nil, nil
	S.statSeen = nil
	S.noTitanAt = nil
	S.resultSeenSig = nil
	S.stuckCount, S.stuckSince, S.lastDist = 0, nil, nil
	S.statsAt = clock()
	S.lastSlow = clock()
	pcall(function() S.statSeen = tonumber(lp:GetAttribute("Stat")) end)
	S.target = chooseTarget()
	S.state = "starting"
	Refill.tries, Refill.nextPress, Refill.until_ = 0, 0, 0
	Visual.apply()

	if api.setrobloxinput then pcall(api.setrobloxinput, true) end
	-- see compactUI: the menu stays reachable, just out of the aim point
	compactUI()
	if UI.win then
		UI.win:Notify({
			Title = "Farming",
			Content = "Menu collapsed to the top-left bar. Tap it to reopen, or press F5 with a keyboard.",
			Duration = 5,
		})
	end

	task.spawn(function()
		while S.running and S.runId == runId do
			local ok, err = pcall(fastTick)
			if not ok then S.err = tostring(err) end
			task.wait(cfg.tick)
		end
	end)
	task.spawn(function()
		while S.running and S.runId == runId do
			local ok, err = pcall(attackTick)
			if not ok then S.err = tostring(err) end
			task.wait(1 / math.max(1, cfg.attackHz))
		end
	end)
	task.spawn(function()
		while S.running and S.runId == runId do
			local ok, err = pcall(slowTick)
			if not ok then S.err = tostring(err) end
			task.wait(0.25)
		end
	end)

	say("started")
	syncFarmToggle()
	refreshStatus()
	return true
end

stopFarm = function()
	if not S.running then
		syncFarmToggle()
		return false
	end
	S.running = false
	S.target = nil
	S.refilling = false
	S.dist = nil
	S.travelling = false
	S.state = "stopped"
	Move.cancel()
	saveStats()
	releaseAll()
	if UI.win then restoreUI() end
	if api.setrobloxinput then pcall(api.setrobloxinput, false) end
	say("stopped")
	syncFarmToggle()
	refreshStatus()
	return true
end

setFarm = function(on)
	on = on == true
	cfg.autoFarm = on
	if on then return startFarm() end
	return stopFarm()
end

-- assigned after the UI exists; guards keep the early calls harmless
