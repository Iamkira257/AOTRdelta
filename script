Farm.state = S
Farm.ui = UI.win
Farm.vega = Vega
Farm.start = startFarm
Farm.stop = stopFarm
Farm.toggle = function() return setFarm(not S.running) end
Farm.restore = restoreNapes
Farm.retry = function(force) return pressRetry(force) end
Farm.panic = panic
Farm.selftest = selftest
Farm.status = function() return table.concat(statusLines(), " | ") end
Farm.stats = Stats.data
Farm.rejoin = rejoinNow
Farm.dumpUI = GuiAuto.dump
Farm.installAutoExec = installAutoExec
Farm.gui = GuiAuto
Farm.visuals = Visual
Farm.move = Move
Farm.notes = "Delta-native AOTR farm. No Matcha, no Drawing."

genv.AOTR_DELTA = Farm
-- getgenv() is the reliable home; _G is mirrored only when it is writable
if type(_G) == "table" and _G ~= genv then
	pcall(function() _G.AOTR_DELTA = Farm end)
end

if UI.win then
	if game.PlaceId ~= PLACE then
		UI.win:Notify({
			Title = "Different place",
			Content = "This farm targets " .. PLACE .. "; loaded in " .. tostring(game.PlaceId) .. ". The menu works, but titan paths will not match.",
			Type = "warning",
			Duration = 10,
		})
	end
	refreshStatus()
end

say("ready - F5 farm, F6 napes, F7 panic. _G.AOTR_DELTA for the API.")
return Farm
