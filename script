local Family = { next = 0 }
local RARITY_ORDER = { "mythical", "legendary", "epic", "rare", "uncommon", "common" }

local function wallet()
	for _, key in ipairs({ "Coins", "Cash", "Money", "Yen", "Gold", "Currency" }) do
		local ok, value = pcall(function() return lp:GetAttribute(key) end)
		if ok and type(value) == "number" then return value end
	end
	local ok, value = pcall(function() return lp.leaderstats.Coins.Value end)
	if ok and type(value) == "number" then return value end
	return nil
end

local function familyStep(now)
	if not cfg.autoFamily or now < Family.next then return end
	Family.next = now + 2.5
	if roundActive() then return end
	local panel = GuiAuto.findPanel({ "family", "families", "clan" })
	if not panel then
		-- never read the whole PlayerGui here: our own status text mentions
		-- "mythical", and so can chat, which would look like a roll result
		local nav = GuiAuto.findButton({ "family", "families" })
		if nav then GuiAuto.click(nav) end
		return
	end
	local text = GuiAuto.labels(panel, 80)
	local flat = normText(text)
	local rarity = nil
	for _, entry in ipairs(RARITY_ORDER) do
		if string.find(flat, entry, 1, true) then rarity = entry break end
	end

	local targets = listOf(cfg.familyTargets)
	local hit = false
	if #targets == 0 then
		hit = rarity == "mythical"
	else
		for _, entry in ipairs(targets) do
			if string.find(flat, normText(entry), 1, true) then hit = true break end
		end
	end

	S.familyRarity = rarity
	if hit then
		if S.familyLast ~= text then
			S.familyLast = text
			Stats.data.mythical = (Stats.data.mythical or 0) + 1
			saveStats()
			local summary = text:sub(1, 300)
			say("family target: " .. tostring(rarity or "?") .. " - " .. summary)
			if cfg.mythicalWebhook and cfg.webhookMythical ~= "" then
				webhookPush(cfg.webhookMythical, {
					username = "AOTR Delta",
					embeds = { embed("Mythical family", summary, 0xB794F6, {
						{ name = "Rarity", value = tostring(rarity or "target"), inline = true },
						{ name = "Player", value = lp.Name, inline = true },
					}) },
				})
			end
			if cfg.storeFamily then
				local store = GuiAuto.findButton({ "store", "save", "equip", "select" }, panel)
				if store then GuiAuto.click(store) end
			end
			cfg.autoFamily = false
			if UI.familyToggle then UI.familyToggle:Set(false, true) end
			if UI.win then
				UI.win:Notify({ Title = "Family found", Content = tostring(rarity or "target") .. " - rolling stopped.", Type = "success", Duration = 8 })
			end
		end
		return
	end

	local coins = wallet()
	if cfg.familyMinCoins > 0 and coins and coins < cfg.familyMinCoins then
		S.autoMsg = "family: low coins (" .. tostring(coins) .. ")"
		return
	end
	local roll = GuiAuto.findButton({ "roll", "reroll", "spin" }, panel, { "reroll all" })
	if roll and GuiAuto.click(roll) then
		S.autoMsg = "family rolled (last: " .. tostring(rarity or "?") .. ")"
	else
		S.autoMsg = "family: roll button not found"
	end
end

