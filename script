-- "two words" and "two_words" must match the same UI text.
local function normText(value)
	return (string.lower(tostring(value or "")):gsub("[^%w]", ""))
end

local function listOf(text)
	local out = {}
	for token in tostring(text or ""):gmatch("[^,]+") do
		local trimmed = token:match("^%s*(.-)%s*$")
		if trimmed ~= "" then out[#out + 1] = trimmed end
	end
	return out
end

local function hasValue(list, value)
	for _, entry in ipairs(list or {}) do
		if entry == value then return true end
	end
	return false
end

--============================================================================
--  GAME-UI AUTOMATION
--  AOTR's menu names are not in the recon, so every lookup is a name-or-text
--  match over a broad alias list. Nothing is cached across a panel rebuild,
--  and every call is pcall-guarded: a renamed button disables exactly one
--  action, never the farm.
--============================================================================
local GuiAuto = {}

local function guiRoots()
	local roots, seen = {}, {}
	local function add(instance)
		if instance and not seen[instance] then
			seen[instance] = true
			roots[#roots + 1] = instance
		end
	end
	local ok, playerGui = pcall(function() return lp:FindFirstChild("PlayerGui") end)
	if ok then add(playerGui) end
	if api.gethui then
		local okHui, hidden = pcall(api.gethui)
		if okHui then add(hidden) end
	end
	local okCore, core = pcall(function() return game:GetService("CoreGui") end)
	if okCore then add(core) end
	return roots
end

local function isOurs(instance)
	local win = UI.win
	local gui = win and win._gui
	if gui then
		local node = instance
		while node do
			if node == gui then return true end
			node = node.Parent
		end
	end
	local node = instance
	while node do
		if node:IsA("ScreenGui") and string.find(normText(node.Name), "vega", 1, true) then return true end
		node = node.Parent
	end
	return false
end

local function guiVisible(instance)
	local node = instance
	while node do
		local okClass, isGui = pcall(function() return node:IsA("GuiObject") end)
		if okClass and isGui then
			local okVisible, visible = pcall(function() return node.Visible end)
			if okVisible and visible == false then return false end
			local okSize, size = pcall(function() return node.AbsoluteSize end)
			if okSize and size and (size.X < 1 or size.Y < 1) then return false end
		end
		node = node.Parent
	end
	return true
end

local function textOf(instance)
	local parts = { tostring(instance.Name or "") }
	local okText, text = pcall(function() return instance.Text end)
	if okText and type(text) == "string" then parts[#parts + 1] = text end
	local okLabel, label = pcall(function() return instance:FindFirstChildWhichIsA("TextLabel", true) end)
	if okLabel and label then
		local ok, value = pcall(function() return label.Text end)
		if ok and type(value) == "string" then parts[#parts + 1] = value end
	end
	return table.concat(parts, " ")
end

local function buttonMatches(instance, aliases)
	local haystack = normText(textOf(instance))
	for _, alias in ipairs(aliases or {}) do
		local needle = normText(alias)
		if needle ~= "" and string.find(haystack, needle, 1, true) then return true, alias end
	end
	return false, nil
end

-- Scope a lookup to a named panel when one exists, otherwise search the whole
-- PlayerGui. The panel path is what stops a generic "Start" from pressing the
-- wrong Start somewhere else in the lobby.
function GuiAuto.findPanel(names)
	for _, root in ipairs(guiRoots()) do
		for _, instance in ipairs(root:GetDescendants()) do
			local okName, name = pcall(function() return instance.Name end)
			if okName and name then
				local flat = normText(name)
				for _, alias in ipairs(names or {}) do
					if string.find(flat, normText(alias), 1, true) and guiVisible(instance) then
						local okClass, isFrame = pcall(function()
							return instance:IsA("Frame") or instance:IsA("ScrollingFrame") or instance:IsA("CanvasGroup")
						end)
						if okClass and isFrame then return instance, alias end
					end
				end
			end
		end
	end
	return nil
end

function GuiAuto.findButton(aliases, scope, exclude)
	local roots = scope and { scope } or guiRoots()
	local excludeFlat = {}
	for _, entry in ipairs(exclude or {}) do excludeFlat[#excludeFlat + 1] = normText(entry) end
	for _, root in ipairs(roots) do
		for _, instance in ipairs(root:GetDescendants()) do
			local okButton, isButton = pcall(function() return instance:IsA("GuiButton") end)
			if okButton and isButton and not isOurs(instance) and guiVisible(instance) then
				local matched = buttonMatches(instance, aliases)
				if matched then
					local flat = normText(textOf(instance))
					local skip = false
					for _, entry in ipairs(excludeFlat) do
						if string.find(flat, entry, 1, true) then skip = true break end
					end
					if not skip then return instance, matched end
				end
			end
		end
	end
	return nil
end

-- Fire the game's own connections first (a real click does the same), then a
-- synthetic mouse event at the button centre for buttons whose handlers are
-- hidden from getconnections.
function GuiAuto.click(button)
	if not button or not button.Parent then return false, "button is gone" end
	local okActivated, fired = pcall(fireSignal, button.Activated)
	if okActivated and fired then return true, "activated" end
	local okMouse, firedMouse = pcall(fireSignal, button.MouseButton1Click)
	if okMouse and firedMouse then return true, "mouse" end
	local okVim, vim = pcall(function() return game:GetService("VirtualInputManager") end)
	if okVim and vim then
		local okPos, position = pcall(function()
			return button.AbsolutePosition + button.AbsoluteSize / 2
		end)
		if okPos and position then
			local okSend = pcall(function()
				vim:SendMouseButtonEvent(position.X, position.Y, 0, true, game, 1)
				task.wait(0.05)
				vim:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 1)
			end)
			if okSend then return true, "input" end
		end
	end
	return false, "no click path"
end

function GuiAuto.labels(scope, limit)
	local texts = {}
	local query = scope or (lp:FindFirstChild("PlayerGui"))
	if not query then return "" end
	for _, instance in ipairs(query:GetDescendants()) do
		local okLabel, isLabel = pcall(function() return instance:IsA("TextLabel") end)
		if okLabel and isLabel and guiVisible(instance) then
			local okText, text = pcall(function() return instance.Text end)
			if okText and type(text) == "string" and text ~= "" then
				texts[#texts + 1] = text
				if #texts >= (limit or 120) then break end
			end
		end
	end
	return table.concat(texts, " | ")
end

function GuiAuto.dump()
	local buttons, labels = 0, 0
	for _, root in ipairs(guiRoots()) do
		for _, instance in ipairs(root:GetDescendants()) do
			local okButton, isButton = pcall(function() return instance:IsA("GuiButton") end)
			if okButton and isButton and not isOurs(instance) and guiVisible(instance) then
				buttons = buttons + 1
				if buttons <= 220 then say("BTN " .. tostring(instance:GetFullName()) .. "  [" .. normText(textOf(instance)) .. "]") end
			end
		end
	end
	say("UI dump: " .. buttons .. " visible buttons (220 printed). Copy this list if an action says 'button not found'.")
	return buttons
end

--============================================================================
--  MOVEMENT: TWEEN / HOVER / TELEPORT
--============================================================================
Move = { active = false, tween = nil }

function Move.cancel()
	if Move.tween then pcall(function() Move.tween:Cancel() end) end
	Move.tween = nil
	Move.active = false
	S.travelling = false
	local _, root = myChar()
	if root then pcall(function() root.Anchored = false end) end
end

--  Tween travel anchors the root for the flight, then unanchors it. The speed is
--  capped so a long flight is never a single frame jump, which is the whole
--  point: the server sees a continuous position track instead of a teleport.
function Move.travel(point, speed)
	local _, root = myChar()
	if not root then return false end
	if cfg.moveMode == "teleport" then
		pcall(function() root.CFrame = CFrame.new(point) end)
		return true
	end
	if cfg.moveMode == "hover" then return false end
	local distance = (root.Position - point).Magnitude
	if distance < 3 then return true end
	if Move.active then Move.cancel() end
	Move.active = true
	S.travelling = true
	local duration = math.clamp(distance / math.max(40, tonumber(speed) or cfg.travelSpeed), 0.08, 4)
	local okAnchor = pcall(function() root.Anchored = true end)
	if not okAnchor then
		Move.active = false
		S.travelling = false
		return false
	end
	local okTween, tween = pcall(function()
		return TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(point) })
	end)
	if not okTween or not tween then
		Move.cancel()
		return false
	end
	Move.tween = tween
	if not pcall(function() tween:Play() end) then
		Move.cancel()
		return false
	end
	task.spawn(function()
		local deadline = clock() + duration + 0.75
		while Move.tween == tween and clock() < deadline do task.wait(0.03) end
		if Move.tween == tween then
			Move.tween = nil
			Move.active = false
			S.travelling = false
			local _, finishedRoot = myChar()
			if finishedRoot then
				pcall(function()
					finishedRoot.Anchored = false
					finishedRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				end)
			end
		end
	end)
	return true
end

