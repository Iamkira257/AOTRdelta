--============================================================================
--  SELFTEST / PANIC / DESTROY
--============================================================================
local function selftest()
	local passed, failed, info = 0, 0, 0
	local lines = {}

	local function add(kind, label, detail)
		if kind == "PASS" then passed = passed + 1
		elseif kind == "FAIL" then failed = failed + 1
		else info = info + 1 end
		lines[#lines + 1] = string.format("%-4s %s%s", kind, label,
			detail ~= nil and (" - " .. tostring(detail)) or "")
	end

	add(game.PlaceId == PLACE and "PASS" or "FAIL", "place", tostring(game.PlaceId) .. " (expected " .. PLACE .. ")")
	add(UI.ready and "PASS" or "INFO", "Vega UI", UI.ready and "window built" or "headless / build failed")

	local char, root, humanoid = myChar()
	add(root and "PASS" or "FAIL", "character", char and char.Name)
	add(humanoid and humanoid.Health > 0 and "PASS" or "INFO", "humanoid health", humanoid and humanoid.Health)

	local titans = workspace:FindFirstChild("Titans")
	add(titans and "PASS" or "INFO", "Titans folder", titans and #titans:GetChildren())
	local target = chooseTarget()
	add(target and "PASS" or "INFO", "target", target and target.name)
	add(target and target.nape and "PASS" or "INFO", "nape path",
		target and target.nape and target.nape:GetFullName())

	local gas = gasPercent()
	add(gas and "PASS" or "INFO", "gas HUD", gas and (tostring(gas) .. "%"))
	local part = refillPart()
	add(part and "PASS" or "FAIL", "gas station", part and part:GetFullName())
	add((refills() or 0) > 0 and "PASS" or "INFO", "blade sets", refills())

	local stat = nil
	pcall(function() stat = tonumber(lp:GetAttribute("Stat")) end)
	add(stat and "PASS" or "INFO", "Stat attribute", stat)

	add(api.mouse1click and "PASS" or (api.mouse1press and "PASS" or "FAIL"), "attack input",
		api.mouse1click and "mouse1click" or (api.mouse1press and "mouse1press" or "none"))
	add(api.getconnections and "PASS" or "INFO", "getconnections", api.getconnections and "available" or "missing")
	add(api.firesignal and "PASS" or "INFO", "firesignal", api.firesignal and "available" or "missing")
	add(api.isexecutorclosure and "PASS" or "INFO", "isexecutorclosure", api.isexecutorclosure and "available" or "missing")
	add(api.hookfunction and "PASS" or "INFO", "hookfunction", api.hookfunction and "available (not used)" or "missing")
	add(api.keypress and "PASS" or "INFO", "keyboard input", api.keypress and "available" or "missing")
	local retryButton = findResultsButton()
	add(retryButton and "PASS" or "INFO", "Retry button", retryButton and retryButton:GetFullName())
	add(resultsInfo() and "PASS" or "INFO", "results HUD", resultsInfo() and "present" or "not on results screen")

	-- v3 paths
	local tweenOk = pcall(function()
		local probe = Instance.new("Frame")
		local tween = TweenService:Create(probe, TweenInfo.new(0.1), { BackgroundTransparency = 1 })
		return tween ~= nil
	end)
	add(tweenOk and "PASS" or "FAIL", "TweenService", tweenOk and "available" or "missing")
	local httpFn = (type(request) == "function") or (type(http_request) == "function")
	add(httpFn and "PASS" or "INFO", "HTTP for webhooks", httpFn and "available" or "missing (webhooks will report no http API)")
	local httpUrl = cfg.webhookRewards ~= "" or cfg.webhookStats ~= ""
	local webhookKind = "INFO"
	if httpUrl then webhookKind = httpFn and "PASS" or "WARN" end
	add(webhookKind, "webhook config", httpUrl and "URL set" or "no URL set")
	local vimOk = pcall(function() return game:GetService("VirtualInputManager") end)
	add(vimOk and "PASS" or "INFO", "VirtualInputManager", vimOk and "available (UI fallback click)" or "missing")
	local panel, panelAlias = GuiAuto.findPanel(MODE_PANELS[cfg.autoStartMode] or { "mission", "raid", "wave" })
	add(panel and "PASS" or "INFO", "auto-start panel", panel and (tostring(panel:GetFullName()) .. " via " .. tostring(panelAlias)) or "not open - open the mode once and rerun")
	add(roundActive() and "PASS" or "INFO", "round detection", roundActive() and "a round is active" or "lobby / no round")
	add(type(S.shadow) == "string" and "PASS" or "INFO", "shadow check", S.shadow or "not run yet")
	local statsOk = api.writefile ~= nil
	add(statsOk and "PASS" or "INFO", "stats file", statsOk and STATS_PATH or "no writefile; stats stay in memory")

	for _, line in ipairs(lines) do say(line) end
	S.state = string.format("self-test %d pass / %d fail / %d info", passed, failed, info)
	if UI.status then UI.status:Set(table.concat(lines, "\n")) end
	if UI.win then
		UI.win:Notify({
			Title = "Self-test",
			Content = string.format("%d pass, %d fail, %d info - full result in the console (F9).", passed, failed, info),
			Type = failed == 0 and "success" or "warning",
			Duration = 8,
		})
	end
	return lines, passed, failed, info
end

local function panic()
	stopFarm()
	local restored = restoreNapes()
	releaseAll()
	local _, root = myChar()
	local spot = safeSpot()
	if root and spot then
		pcall(function()
			root.Position = spot
			root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end)
	end
	S.state = "panic - restored " .. tostring(restored) .. " napes"
	refreshStatus()
	return restored
end

local Farm = {}
Farm.version = VERSION
Farm.cfg = cfg

function Farm.destroy()
	pcall(stopFarm)
	pcall(restoreNapes)
	pcall(Move.cancel)
	pcall(Visual.restore)
	pcall(saveStats)
	releaseAll()
	UI.status = nil
	if UI.win then
		pcall(function() UI.win:Destroy() end)
		UI.win = nil
	end
	if genv.AOTR_DELTA == Farm then genv.AOTR_DELTA = nil end
	-- some builds expose _G as read-only, so this mirror is best-effort
	if type(_G) == "table" and _G ~= genv and _G.AOTR_DELTA == Farm then
		pcall(function() _G.AOTR_DELTA = nil end)
	end
	say("unloaded")
end

