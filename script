local Escape = { nextScan = 0, labels = {}, lastTap = 0, direction = 1 }

local function isGrabbed()
	if not S.running or S.results then return false end
	local _, _, humanoid = myChar()
	if humanoid then
		local ok, standing = pcall(function() return humanoid.PlatformStand end)
		if ok and standing then return true end
	end
	local character = lp.Character
	if character then
		for _, key in ipairs({ "Grabbed", "Grab", "Eaten", "InGrab" }) do
			local ok, value = pcall(function() return character:GetAttribute(key) end)
			if ok and value ~= nil and value ~= false then return true end
		end
	end
	local now = clock()
	if now >= Escape.nextScan then
		Escape.nextScan = now + 1.2
		Escape.labels = {}
		local playerGui = lp:FindFirstChild("PlayerGui")
		local scope = playerGui and (playerGui:FindFirstChild("Interface") or playerGui)
		if scope then
			for _, instance in ipairs(scope:GetDescendants()) do
				if instance:IsA("TextLabel") and guiVisible(instance) then
					local ok, text = pcall(function() return instance.Text end)
					if ok and type(text) == "string" then
						local flat = normText(text)
						if string.find(flat, "escape", 1, true) or string.find(flat, "mash", 1, true)
							or string.find(flat, "struggle", 1, true) or string.find(flat, "getfree", 1, true) then
							Escape.labels[#Escape.labels + 1] = instance
						end
					end
				end
			end
		end
	end
	for _, label in ipairs(Escape.labels) do
		local ok, visible = pcall(function() return label.Visible end)
		if ok and visible then return true end
	end
	return false
end

local function escapeStep(now)
	if not cfg.autoEscape then return end
	if not S.running or S.results then return end
	if not isGrabbed() then return end
	if now - Escape.lastTap < 0.09 then return end
	Escape.lastTap = now
	if api.keypress and api.keyrelease then
		local key = Escape.direction == 1 and 0x41 or 0x44 -- A / D
		Escape.direction = -Escape.direction
		pcall(api.keypress, key)
		pcall(api.keyrelease, key)
	end
	if math.floor(now * 10) % 4 == 0 then click() end
	S.state = "escaping a grab"
end

local Skill = { next = 0, codes = nil }
local function skillCodes()
	if Skill.codes then return Skill.codes end
	local codes = {}
	for token in tostring(cfg.skillKeys or ""):gmatch("[^,]+") do
		token = token:gsub("%s", "")
		local char = token:sub(1, 1):upper()
		local byte = string.byte(char)
		if char:match("%u") then
			codes[#codes + 1] = 0x41 + (byte - 65)
		elseif char:match("%d") then
			codes[#codes + 1] = 0x30 + (byte - 48)
		end
	end
	Skill.codes = codes
	return codes
end

local function skillsStep(now)
	if not cfg.autoSkills or not S.running or S.results then return end
	if now < Skill.next then return end
	Skill.next = now + math.max(0.15, cfg.skillDelay)
	if not S.target or uiBusy() then return end
	if cfg.focusGuard and not focused() then return end
	if not api.keypress or not api.keyrelease then return end
	for _, code in ipairs(skillCodes()) do
		pcall(api.keypress, code)
		pcall(api.keyrelease, code)
	end
end

local function spearsStep(now)
	if not cfg.infiniteSpears then return end
	if now < (S.spearAt or 0) then return end
	S.spearAt = now + 1
	local containers = {}
	local character = lp.Character
	if character then containers[#containers + 1] = character end
	local backpack = lp:FindFirstChildOfClass("Backpack")
	if backpack then containers[#containers + 1] = backpack end
	local touched = 0
	for _, container in ipairs(containers) do
		for _, tool in ipairs(container:GetChildren()) do
			if tool:IsA("Tool") and string.find(normText(tool.Name), "spear", 1, true) then
				for _, item in ipairs(tool:GetDescendants()) do
					if item:IsA("IntValue") or item:IsA("NumberValue") then
						local flat = normText(item.Name)
						if string.find(flat, "ammo", 1, true) or string.find(flat, "charge", 1, true)
							or string.find(flat, "count", 1, true) or string.find(flat, "uses", 1, true) then
							if item.Value ~= 99 then
								if pcall(function() item.Value = 99 end) then touched = touched + 1 end
							end
						end
					end
				end
				local okAttributes, attributes = pcall(function() return tool:GetAttributes() end)
				if okAttributes and type(attributes) == "table" then
					for key, value in pairs(attributes) do
						local flat = normText(key)
						if type(value) == "number" and (string.find(flat, "ammo", 1, true)
							or string.find(flat, "charge", 1, true) or string.find(flat, "count", 1, true)) then
							if value ~= 99 then
								if pcall(function() tool:SetAttribute(key, 99) end) then touched = touched + 1 end
							end
						end
					end
				end
			end
		end
	end
	S.spears = touched > 0
	if touched > 0 then S.autoMsg = "spears: " .. touched .. " value(s) topped up" end
end

