local function loaderSource()
	return string.format([[
local ok, err = pcall(function()
	local source = readfile(%q)
	local chunk = loadstring(source)
	if not chunk then error("loadstring failed") end
	chunk()
end)
if not ok then warn("[AOTR] autoexec: " .. tostring(err)) end
]], cfg.scriptPath)
end

rejoinNow = function(reason)
	if S.rejoining then return end
	S.rejoining = true
	saveStats()
	S.autoMsg = "rejoining: " .. tostring(reason)
	say(S.autoMsg)
	if cfg.autoExec and api.queue_on_teleport then pcall(api.queue_on_teleport, loaderSource()) end
	task.spawn(function()
		task.wait(0.4)
		local ok = pcall(function() TeleportService:Teleport(PLACE) end)
		if not ok then
			ok = pcall(function() TeleportService:TeleportToPlaceInstance(PLACE, game.JobId) end)
		end
		if not ok then
			S.rejoining = false
			S.autoMsg = "rejoin failed (TeleportService refused)"
			say(S.autoMsg)
		end
	end)
	return true
end

local function installAutoExec()
	if not api.writefile then return false, "this executor has no writefile" end
	local folder = "autoexec"
	if api.isfolder and not api.isfolder(folder) then
		if api.makefolder then pcall(api.makefolder, folder) end
	end
	local path = folder .. "/aotr_delta.lua"
	local ok = pcall(api.writefile, path, loaderSource())
	if ok and api.queue_on_teleport then
		pcall(api.queue_on_teleport, loaderSource())
	end
	return ok, path
end

