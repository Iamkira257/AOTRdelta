local Visual = { saved = nil, threeD = false }

local function visualSnapshot()
	if Visual.saved then return end
	local saved = {}
	pcall(function()
		saved.fogStart = Lighting.FogStart
		saved.fogEnd = Lighting.FogEnd
		saved.globalShadows = Lighting.GlobalShadows
	end)
	pcall(function() saved.quality = settings().Rendering.QualityLevel end)
	if api.getfpscap then pcall(function() saved.fps = api.getfpscap() end) end
	local okAtmo, atmosphere = pcall(function() return Lighting:FindFirstChildOfClass("Atmosphere") end)
	if okAtmo and atmosphere then
		saved.atmosphere = atmosphere
		pcall(function() saved.density = atmosphere.Density end)
	end
	Visual.saved = saved
end

function Visual.apply()
	visualSnapshot()
	if cfg.removeFog then
		pcall(function()
			Lighting.FogStart = 100000
			Lighting.FogEnd = 100000
		end)
		if Visual.saved.atmosphere then pcall(function() Visual.saved.atmosphere.Density = 0 end) end
	elseif Visual.saved then
		pcall(function()
			if Visual.saved.fogStart then Lighting.FogStart = Visual.saved.fogStart end
			if Visual.saved.fogEnd then Lighting.FogEnd = Visual.saved.fogEnd end
		end)
		if Visual.saved.atmosphere and Visual.saved.density then
			pcall(function() Visual.saved.atmosphere.Density = Visual.saved.density end)
		end
	end

	if cfg.disable3D then
		local ok = pcall(function() RunService:Set3dRenderingEnabled(false) end)
		if ok then
			Visual.threeD = true
		else
			S.autoMsg = "3D toggle is not available in this build"
		end
	elseif Visual.threeD then
		pcall(function() RunService:Set3dRenderingEnabled(true) end)
		Visual.threeD = false
	end

	if cfg.performance then
		pcall(function() Lighting.GlobalShadows = false end)
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		if api.setfpscap then pcall(api.setfpscap, 30) end
	else
		if Visual.saved and Visual.saved.globalShadows ~= nil then
			pcall(function() Lighting.GlobalShadows = Visual.saved.globalShadows end)
		end
		if Visual.saved and Visual.saved.quality ~= nil then
			pcall(function() settings().Rendering.QualityLevel = Visual.saved.quality end)
		end
		if Visual.saved and Visual.saved.fps and api.setfpscap then pcall(api.setfpscap, Visual.saved.fps) end
	end
end

function Visual.restore()
	if Visual.threeD then pcall(function() RunService:Set3dRenderingEnabled(true) end) end
	Visual.threeD = false
	if Visual.saved then
		pcall(function()
			if Visual.saved.fogStart then Lighting.FogStart = Visual.saved.fogStart end
			if Visual.saved.fogEnd then Lighting.FogEnd = Visual.saved.fogEnd end
			if Visual.saved.globalShadows ~= nil then Lighting.GlobalShadows = Visual.saved.globalShadows end
		end)
		if Visual.saved.quality ~= nil then
			pcall(function() settings().Rendering.QualityLevel = Visual.saved.quality end)
		end
		if Visual.saved.fps and api.setfpscap then pcall(api.setfpscap, Visual.saved.fps) end
		if Visual.saved.atmosphere and Visual.saved.density then
			pcall(function() Visual.saved.atmosphere.Density = Visual.saved.density end)
		end
	end
	Visual.saved = nil
end

--============================================================================
--  ROUND AUTOMATION: START / RAIDS / WAVES / DIFFICULTY / MODIFIERS
--============================================================================
local Auto = { next = 0, lastDetail = nil }
local MODE_PANELS = {
	mission = { "mission", "missions", "story", "campaign" },
	raid = { "raid", "raids" },
	wave = { "wave", "waves", "endless", "survival" },
	mastery = { "mastery", "masteries", "titanmastery" },
}

local function roundActive()
	local folder = workspace:FindFirstChild("Titans")
	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") and not dead(model) then return true end
		end
	end
	if resultsSignature() then return true end
	local ok, kind = pcall(function() return workspace:GetAttribute("Type") end)
	if not ok or kind == nil then return false end
	local flat = normText(kind)
	return flat ~= "" and flat ~= "none" and flat ~= "lobby"
end

local function chooseDifficulty()
	local ladder = { "Easy", "Normal", "Hard", "Aberrant", "Freedom" }
	local found = {}
	for _, name in ipairs(ladder) do
		local button = GuiAuto.findButton({ name })
		if button then found[#found + 1] = { name = name, button = button } end
	end
	if #found == 0 then return false, "no difficulty buttons" end
	local pick = found[#found]
	if cfg.difficulty ~= "Hardest" then
		for _, entry in ipairs(found) do
			if normText(entry.name) == normText(cfg.difficulty) then pick = entry break end
		end
	end
	local ok = GuiAuto.click(pick.button)
	return ok, pick.name
end

local ModifierGate = { at = 0, done = false }
local function autoModifiersStep(now)
	if not cfg.autoModifiers then return end
	if ModifierGate.done then return end
	if now < ModifierGate.at then return end
	ModifierGate.at = now + 7
	local panel = GuiAuto.findPanel({ "modifier", "modifiers", "mods" })
	if not panel then
		local nav = GuiAuto.findButton({ "modifier", "modifiers" })
		if nav then GuiAuto.click(nav) end
		return
	end
	ModifierGate.done = true
	local exclude = listOf(cfg.modifierExclude)
	local blacklist = { "start", "close", "back", "confirm", "remove", "cancel",
		"reroll", "random", "reset", "clear" }
	for _, entry in ipairs(blacklist) do exclude[#exclude + 1] = entry end
	local clicked = 0
	for _, instance in ipairs(panel:GetDescendants()) do
		if clicked >= 10 then break end
		local okButton, isButton = pcall(function() return instance:IsA("GuiButton") end)
		if okButton and isButton and guiVisible(instance) and not isOurs(instance) then
			local flat = normText(textOf(instance))
			local skip = false
			for _, entry in ipairs(exclude) do
				if string.find(flat, normText(entry), 1, true) then skip = true break end
			end
			if not skip and GuiAuto.click(instance) then clicked = clicked + 1 end
		end
	end
	S.autoMsg = "modifiers: " .. clicked .. " clicked"
end

function Auto.start(mode)
	-- the dropdown stores "Missions"/"Raids"/"Waves"; the panel table is singular
	local key = string.gsub(string.lower(tostring(mode or "")), "s$", "")
	local names = MODE_PANELS[key] or MODE_PANELS[mode] or { mode }
	local panel = GuiAuto.findPanel(names)
	if not panel then
		local nav = GuiAuto.findButton(names)
		if nav then GuiAuto.click(nav) end
		return false, "opened the " .. mode .. " panel"
	end

	if key == "raid" and #cfg.raidTypes > 0 then
		local index = ((S.raidIndex or 1) - 1) % #cfg.raidTypes + 1
		local card = GuiAuto.findButton({ cfg.raidTypes[index] }, panel)
		if card then GuiAuto.click(card) end
	end

	chooseDifficulty()
	autoModifiersStep(clock())

	local start = GuiAuto.findButton(
		{ "start", "play", "begin", "deploy", "launch", "join", "ready", "solo" },
		panel, { "restart" })
	if not start then return false, "no Start button in the " .. mode .. " panel" end
	local ok, how = GuiAuto.click(start)
	if ok then
		S.autoStarts = (S.autoStarts or 0) + 1
		if key == "raid" and cfg.raidRotate and #cfg.raidTypes > 0 then
			S.raidIndex = ((S.raidIndex or 1) % #cfg.raidTypes) + 1
		end
		return true, "start clicked (" .. tostring(how) .. ")"
	end
	return false, "Start was found but could not be clicked"
end

local function autoStartStep(now)
	local mode = string.lower(tostring(cfg.autoStartMode or "none"))
	if mode == "none" then return end
	if not S.running or S.results then return end
	if now < Auto.next then return end
	Auto.next = now + 6
	if roundActive() then return end
	if S.soloBlocked or uiBusy() then return end
	local ok, detail = Auto.start(mode)
	Auto.lastDetail = detail
	S.autoMsg = "auto start: " .. tostring(detail)
	if not ok then
		S.autoNext = now + 2
	end
end

--============================================================================
--  PROGRESSION: SKILL TREE / PERKS / SLOT / PRESTIGE / BOOSTS / CRATES
--============================================================================
local Prog = { next = 0, sellAt = 0, prestigeAt = 0 }

local function cardName(button, panel)
	local node = button.Parent
	for _ = 1, 4 do
		if not node or node == panel then break end
		for _, descendant in ipairs(node:GetDescendants()) do
			if descendant:IsA("TextLabel") and guiVisible(descendant) then
				local ok, text = pcall(function() return descendant.Text end)
				if ok and type(text) == "string" and #text >= 3 and #text <= 42 then
					local flat = normText(text)
					if not string.find(flat, "equip", 1, true) and not string.find(flat, "sell", 1, true)
						and not string.find(flat, "enhance", 1, true) then
						return text
					end
				end
			end
		end
		node = node.Parent
	end
	return nil
end

local function skillTreeStep(now)
	if not cfg.autoSkillTree or now < Prog.next then return end
	Prog.next = now + 1.4
	local panel = GuiAuto.findPanel({ "skilltree", "masterytree", "skill tree" })
	if not panel then
		local nav = GuiAuto.findButton({ "skill tree", "skills", "mastery" })
		if nav then GuiAuto.click(nav) end
		return
	end
	local priority = listOf(cfg.skillPriority)
	local clicked = 0
	for _, name in ipairs(priority) do
		if clicked >= 2 then break end
		local button = GuiAuto.findButton({ name }, panel)
		if button and GuiAuto.click(button) then clicked = clicked + 1 end
	end
	if clicked == 0 then
		local button = GuiAuto.findButton({ "unlock", "learn", "upgrade", "purchase", "level up" }, panel)
		if button and GuiAuto.click(button) then clicked = 1 end
	end
	if clicked > 0 then
		S.autoMsg = "skill tree: " .. clicked .. " node(s) unlocked"
	else
		S.autoMsg = "skill tree: no unlockable node found"
	end
end

local function perkStep(now)
	-- this step runs whenever ANY progression option is on, so it must not
	-- navigate on its own unless a perk option is actually enabled
	if not (cfg.autoEquipPerks or cfg.enhancePerks or #listOf(cfg.sellPerks) > 0) then return end
	local panel = GuiAuto.findPanel({ "perk", "perks" })
	if not panel then
		local nav = GuiAuto.findButton({ "perk", "perks" })
		if nav then GuiAuto.click(nav) end
		return
	end

	if cfg.autoEquipPerks then
		local equip = GuiAuto.findButton({ "equip" }, panel, { "unequip", "equipped" })
		if equip then
			local name = cardName(equip, panel)
			if GuiAuto.click(equip) then S.autoMsg = "perk equipped: " .. tostring(name or "?") end
		end
	end

	if cfg.enhancePerks then
		local limit = cfg.enhanceAllPerks and 4 or 1
		for _ = 1, limit do
			local enhance = GuiAuto.findButton({ "enhance", "upgrade" }, panel, { "max", "equip", "sell" })
			if not enhance or not GuiAuto.click(enhance) then break end
		end
		S.autoMsg = "perks: enhance pass done"
	end

	local sellList = listOf(cfg.sellPerks)
	if #sellList > 0 and now >= Prog.sellAt then
		for _, instance in ipairs(panel:GetDescendants()) do
			local okButton, isButton = pcall(function() return instance:IsA("GuiButton") end)
			if okButton and isButton and guiVisible(instance) then
				local isSell = buttonMatches(instance, { "sell" })
				if isSell then
					local name = cardName(instance, panel)
					local target = nil
					for _, entry in ipairs(sellList) do
						if name and string.find(normText(name), normText(entry), 1, true) then target = entry break end
					end
					if target and GuiAuto.click(instance) then
						Prog.sellAt = now + 2
						S.autoMsg = "perk sold: " .. tostring(name)
						task.delay(0.35, function()
							local confirm = GuiAuto.findButton({ "confirm", "yes" }, nil, { "cancel", "no" })
							if confirm then GuiAuto.click(confirm) end
						end)
						break
					end
				end
			end
		end
	end
end

local function slotStep()
	if cfg.autoSlot < 1 or S.slotDone then return end
	local panel = GuiAuto.findPanel({ "slot", "slots", "loadout", "character" })
	if not panel then
		local nav = GuiAuto.findButton({ "slots", "loadout", "characters" })
		if nav then GuiAuto.click(nav) end
		return
	end
	local button = GuiAuto.findButton({ "slot " .. cfg.autoSlot, "slot" .. cfg.autoSlot }, panel)
	if button and GuiAuto.click(button) then
		S.slotDone = true
		S.autoMsg = "selected slot " .. cfg.autoSlot
	end
end

local function prestigeStep(now)
	if not cfg.autoPrestige or now < Prog.prestigeAt then return end
	Prog.prestigeAt = now + 8
	local button = GuiAuto.findButton({ "prestige", "reborn", "ascend" }, nil, { "boost", "perk" })
	if not button then return end
	if GuiAuto.click(button) then
		S.autoMsg = "prestige clicked"
		task.delay(0.5, function()
			local confirm = GuiAuto.findButton({ "confirm", "yes", "prestige" }, nil, { "cancel", "no" })
			if confirm then GuiAuto.click(confirm) end
		end)
	end
end

local BoostsGate = { at = 0 }
local function boostsStep()
	if not cfg.autoBoosts then return end
	if clock() < BoostsGate.at then return end
	BoostsGate.at = clock() + 5
	local panel = GuiAuto.findPanel({ "boost", "boosts" })
	if not panel then
		local nav = GuiAuto.findButton({ "boosts", "boost" })
		if nav then GuiAuto.click(nav) end
		return
	end
	local names = listOf(cfg.boostNames)
	if #names == 0 then names = { "boost", "xp", "2x" } end
	for _, entry in ipairs(names) do
		local used = GuiAuto.findButton({ entry }, panel, { "buy" })
		if used then GuiAuto.click(used) end
	end
	if cfg.buyBoosts then
		local buy = GuiAuto.findButton({ "buy", "purchase" }, panel)
		if buy then
			GuiAuto.click(buy)
			task.delay(0.4, function()
				local confirm = GuiAuto.findButton({ "confirm", "yes", "buy" }, nil, { "cancel", "no" })
				if confirm then GuiAuto.click(confirm) end
			end)
		end
	end
end

local CratesGate = { at = 0 }
local function cratesStep()
	if not cfg.autoCrates then return end
	if clock() < CratesGate.at then return end
	CratesGate.at = clock() + 3
	local panel = GuiAuto.findPanel({ "crate", "crates", "chest", "chests" })
	if not panel then
		local nav = GuiAuto.findButton({ "crates", "crate", "chests" })
		if nav then GuiAuto.click(nav) end
		return
	end
	for _ = 1, 2 do
		local open = GuiAuto.findButton({ "open", "open all", "unlock" }, panel, { "open menu" })
		if not open or not GuiAuto.click(open) then break end
		task.delay(0.5, function()
			local confirm = GuiAuto.findButton({ "open", "confirm", "yes" }, nil, { "cancel", "no" })
			if confirm then GuiAuto.click(confirm) end
		end)
	end
end

local function achievementsStep()
	if not cfg.autoAchievements then return end
	local panel = GuiAuto.findPanel({ "achievement", "achievements" })
	if not panel then
		local nav = GuiAuto.findButton({ "achievements", "achievement" })
		if nav then GuiAuto.click(nav) end
		return
	end
	local claimed = 0
	for _, instance in ipairs(panel:GetDescendants()) do
		if claimed >= 6 then break end
		local okButton, isButton = pcall(function() return instance:IsA("GuiButton") end)
		if okButton and isButton and guiVisible(instance) and buttonMatches(instance, { "claim" }) then
			if GuiAuto.click(instance) then claimed = claimed + 1 end
		end
	end
	if claimed > 0 then S.autoMsg = "achievements claimed: " .. claimed end
end

local ProgGate = { at = 0 }
local function progressionStep(now)
	local wanted = cfg.autoSkillTree or cfg.autoEquipPerks or cfg.enhancePerks
		or #listOf(cfg.sellPerks) > 0
		or cfg.autoSlot > 0 or cfg.autoPrestige or cfg.autoBoosts or cfg.autoCrates or cfg.autoAchievements
	if not wanted then return end
	if now < ProgGate.at then return end
	ProgGate.at = now + 1.8
	if roundActive() then return end
	skillTreeStep(now)
	perkStep(now)
	slotStep()
	prestigeStep(now)
	boostsStep()
	cratesStep()
	achievementsStep()
end

