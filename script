local function hudTop()
	local playerGui = lp:FindFirstChild("PlayerGui")
	local interface = playerGui and playerGui:FindFirstChild("Interface")
	local hud = interface and interface:FindFirstChild("HUD")
	local main = hud and hud:FindFirstChild("Main")
	return main and main:FindFirstChild("Top")
end

-- Gas and Blades sit one numbered wrapper frame below Top; two levels of
-- search are enough and survive a layout index changing.
local function hudNode(top, name, depth)
	if not top then return nil end
	local direct = top:FindFirstChild(name)
	if direct then return direct end
	if (depth or 0) >= 2 then return nil end
	for _, child in ipairs(top:GetChildren()) do
		local found = hudNode(child, name, (depth or 0) + 1)
		if found then return found end
	end
	return nil
end

local function gasPercent()
	local gas = hudNode(hudTop(), "Gas")
	local percentage = gas and gas:FindFirstChild("Percentage")
	if not percentage then return nil end
	local ok, text = pcall(function() return percentage.Text end)
	if not ok or type(text) ~= "string" then return nil end
	return tonumber(string.match(text, "(%d+)"))
end

local function refills()
	local ok, value = pcall(function() return tonumber(lp:GetAttribute("Refills")) end)
	if ok and value then return value end
	local blades = hudNode(hudTop(), "Blades")
	local sets = blades and blades:FindFirstChild("Sets")
	if not sets then return 0 end
	local ok2, text = pcall(function() return sets.Text end)
	if not ok2 or type(text) ~= "string" then return 0 end
	return tonumber(string.match(text, "(%d+)")) or 0
end

local function bladesAllBroken(char)
	local rig = char and char:FindFirstChild("Rig_" .. lp.Name)
	local left = rig and rig:FindFirstChild("LeftHand")
	local right = rig and rig:FindFirstChild("RightHand")
	if not left or not right then return false end
	for _, hand in ipairs({ left, right }) do
		for index = 1, 7 do
			local blade = hand:FindFirstChild("Blade_" .. index)
			if not blade then return false end
			local ok, transparency = pcall(function() return blade.Transparency end)
			if not ok or transparency ~= 1 then return false end
		end
	end
	return true
end

--============================================================================
--  REFILL
--============================================================================
local Refill = { tries = 0, nextPress = 0, until_ = 0 }

local function findPrompt(part)
	if not part then return nil end
	for _, descendant in ipairs(part:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then return descendant end
	end
	local parent = part.Parent
	if parent then
		for _, descendant in ipairs(parent:GetDescendants()) do
			if descendant:IsA("ProximityPrompt") and descendant.Enabled ~= false then
				return descendant
			end
		end
	end
	return nil
end

local function pressRefill(root, part)
	local method = cfg.refillMethod

	if method == "auto" or method == "prompt" then
		local prompt = findPrompt(part)
		if prompt and api.fireproximityprompt then
			if pcall(api.fireproximityprompt, prompt) then return end
		end
		if method == "prompt" then method = "key" end
	end

	if method == "auto" or method == "touch" then
		if api.firetouchinterest then
			if pcall(api.firetouchinterest, root, part, 0) then
				task.delay(0.12, function()
					pcall(api.firetouchinterest, root, part, 1)
				end)
				return
			end
		end
		if method == "touch" then method = "key" end
	end

	if api.keypress then
		pcall(api.keypress, 0x52) -- R
		task.delay(0.3, function()
			if api.keyrelease then pcall(api.keyrelease, 0x52) end
		end)
	end
end

local function refillTick(now, root)
	if not cfg.refill then
		S.refilling = false
		return false
	end

	-- Gas, blade state and blade sets are refreshed once per slow tick. Reading
	-- the HUD / 14 blade parts at 30 Hz was the most expensive thing in the loop.
	local gas = S.gas
	local broken = S.bladesBroken == true and cfg.autoReload ~= false
	local low = gas ~= nil and gas <= cfg.refillGas

	S.refillNeeded = low or broken
	if not low and not broken then
		S.refilling = false
		Refill.tries = 0
		Refill.until_ = 0
		return false
	end

	S.refilling = true

	if now < Refill.until_ then
		S.state = "refill cooldown"
		return true
	end

	if (S.refills or 0) <= 0 then
		S.state = "refill: no blade sets"
		Refill.until_ = now + cfg.refillCooldown
		return true
	end

	local part = refillPart()
	if not part then
		S.state = "refill: no gas station on this map"
		Refill.until_ = now + cfg.refillCooldown
		return true
	end

	local spot = part.Position + Vector3.new(0, 3, 0)
	-- Tween to the tank instead of snapping there: a 300-stud jump across the
	-- map is exactly the movement pattern anti-cheat looks for. While a travel
	-- is in flight this must NOT restart it every refill tick, or the tween is
	-- cancelled and rebuilt 10 times a second and never arrives.
	if cfg.moveMode == "tween" and Move and (root.Position - spot).Magnitude > 10 then
		if not S.travelling then Move.travel(spot, cfg.travelSpeed) end
		S.state = "tweening to gas"
		return true
	end

	pcall(function()
		root.Position = spot
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		local camera = workspace.CurrentCamera
		if camera then
			camera.CFrame = CFrame.lookAt(spot + Vector3.new(0, 6, 0), part.Position)
		end
	end)

	if now >= Refill.nextPress then
		Refill.nextPress = now + 0.7
		Refill.tries = Refill.tries + 1
		pressRefill(root, part)
		if Refill.tries >= cfg.refillTries then
			Refill.tries = 0
			Refill.until_ = now + cfg.refillCooldown
			S.state = "refill: station did not respond"
			return true
		end
	end

	S.state = string.format("refilling (gas %s)", gas and (tostring(gas) .. "%") or "?")
	return true
end

