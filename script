local function loadVega()
	local existing = genv.Vega
	if type(existing) == "table" and type(existing.CreateWindow) == "function" then
		return existing, "getgenv"
	end
	if not api.readfile then
		error("Delta has no readfile; run vega_ui.lua first, then this script", 0)
	end
	local candidates = {
		"vega_ui.lua", "vega_ui.luau",
		"Vega/vega_ui.lua", "Vega/vega_ui.luau",
		"Scripts/vega_ui.lua",
	}
	local lastError = "vega_ui.lua not found in the executor workspace"
	for _, path in ipairs(candidates) do
		local ok, src = pcall(api.readfile, path)
		if ok and type(src) == "string" and #src > 200 then
			if not api.loadstring then
				error("Delta has no loadstring; run vega_ui.lua first, then this script", 0)
			end
			local chunk, compileError = api.loadstring(src, "@" .. path)
			if not chunk then
				lastError = path .. ": " .. tostring(compileError)
			else
				local ran, lib = pcall(chunk)
				if ran and type(lib) == "table" and type(lib.CreateWindow) == "function" then
					genv.Vega = lib
					return lib, path
				end
				lastError = path .. ": " .. tostring(lib)
			end
		end
	end
	error("Could not load Vega UI (" .. lastError .. "). Put vega_ui.lua next to this script, or run vega_ui.lua first.", 0)
end

local okVega, Vega, vegaFrom = pcall(loadVega)
if not okVega then
	warn("[AOTR-Delta] " .. tostring(Vega))
	return
end
